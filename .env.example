# databricks-pulse environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# === Composio MCP (required for posting) ===
COMPOSIO_API_KEY=ck_xxxxxxxxxxxxxxxxxxxx
# COMPOSIO_MCP_HOST=connect.composio.dev    # optional, only set if Composio gives you a different endpoint
# COMPOSIO_MCP_PATH=/mcp                    # optional

# === Platform identifiers (required for posting) ===
INSTAGRAM_UID=00000000000000000
LINKEDIN_URN=urn:li:person:XXXXXXXXXX

# === Anthropic API (required for headless scans via `claude -p`) ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# === Templates location (required when whiteboard render references templates) ===
# On the VM, point this at the templates directory in the repo.
# On Windows local dev, default is C:/Users/Sanju/Social_Media_Project/templates/visuals
TEMPLATES_DIR=/home/ubuntu/databricks-pulse/templates/visuals
